CLAUDE-02-replay-engine.md
plans/
worktrees/
# The directory is committed (its .gitkeep is), its generated contents are
# not. The pattern has to exclude the directory's *contents* rather than
# the directory itself: git cannot re-include a file whose parent
# directory is excluded, so `bench/results/` plus a negation would ignore
# the .gitkeep too.
bench/results/*
!bench/results/.gitkeep
testdata/large/
*.prof
*.pprof
*.test
*.test.exe

# go tool pprof -svg's own rendered output embeds the local machine's
# temp-build path in its Build ID line -- not a source-path issue
# -trimpath would fix, since it names where the binary was compiled,
# not where its source lives. Never commit one. See BENCHMARKS.md and
# the profile target in the Makefile.
profiles/*.svg

# go build ./... with no -o writes a binary named after the package
# directory into cwd. One entry per cmd/ binary, plus its Windows form.
/cmd/replayd/replayd
/cmd/replayd/replayd.exe
/cmd/convert/convert
/cmd/convert/convert.exe
/cmd/catalogue/catalogue
/cmd/catalogue/catalogue.exe
/cmd/lint-determinism/lint-determinism
/cmd/lint-determinism/lint-determinism.exe
